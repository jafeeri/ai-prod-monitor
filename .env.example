# Copy this file to .env and fill in what you need. .env is git-ignored.

# Which LLM backend the demo and the judge use.
#   mock      = deterministic, offline, no key (default)
#   ollama    = a local model via Ollama at http://localhost:11434
#   openai    = OpenAI API      (needs OPENAI_API_KEY)
#   anthropic = Anthropic Claude (needs ANTHROPIC_API_KEY)
#   gemini    = Google Gemini   (needs GEMINI_API_KEY)
MONITOR_LLM=mock

# API keys (only the one for your chosen backend is needed). Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Truncate prompt/response event payloads longer than this many characters.
# 0 disables the cap. Default is 16384.
MONITOR_MAX_EVENT_CHARS=16384
